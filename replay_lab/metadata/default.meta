[]
access = read : [ * ], write : [ admin ]
export = none

# ES's asset and identity merge searches run in SA-IdentityManagement, so the packs' lists
# must be global.
[transforms]
export = system

[lookups]
export = system

# The rule ledger is the app's own: admins and the app's input only.
[collections]
access = read : [ admin ], write : [ admin ]
export = none
